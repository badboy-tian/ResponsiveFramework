{
  "app": {
    "signingConfigs": [],
    "products": [
      {
        "name": "default",
        // 示例默认允许无签名构建，不包含开发者证书。
        // 使用 DevEco 内置 SDK 编译，不固定编译版本；运行接口最低需要 API 12。
        "compatibleSdkVersion": "5.0.0(12)",
        "runtimeOS": "HarmonyOS",
      }
    ],
    "buildModeSet": [
      {
        "name": "debug"
      },
      {
        "name": "profile"
      },
      {
        "name": "release"
      }
    ]
  },
  "modules": [
    {
      "name": "entry",
      "srcPath": "./entry",
      "targets": [
        {
          "name": "default",
          "applyToProducts": [
            "default"
          ]
        }
      ]
    },
    {
      // 与 saver_gallery 一致：示例宿主直接编译库的 ArkTS 插件模块。
      "name": "responsive_framework",
      "srcPath": "../../ohos",
      "targets": [
        {
          "name": "default",
          "applyToProducts": [
            "default"
          ]
        }
      ]
    }
  ]
}
